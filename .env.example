# CineForge AI — environment configuration
#
# Copy this file to .env and adjust the values for your machine.
# All secrets are kept out of source code.

# =============================================================================
# Django
# =============================================================================

# Change this to a unique, unpredictable value in production.
DJANGO_SECRET_KEY=change-me-in-production

# Keep True only for local development.
DEBUG=True

# Comma-separated list of allowed hosts.
ALLOWED_HOSTS=localhost,127.0.0.1

# Time zone for the application.
TIME_ZONE=UTC

# =============================================================================
# Database (SQLite for local development; PostgreSQL-compatible settings below)
# =============================================================================

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=600

# =============================================================================
# Static and media
# =============================================================================

STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media

# =============================================================================
# File uploads
# =============================================================================

# Maximum upload size in MB.
MAX_UPLOAD_SIZE_MB=50

# Allowed image extensions for reference images.
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp

# =============================================================================
# Inference backend
# =============================================================================

# Default inference adapter: comfyui, wan, ltx, or test.
INFERENCE_DEFAULT_ADAPTER=comfyui

# Base URL of the local ComfyUI instance (if used).
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Timeout in seconds for ComfyUI API calls.
COMFYUI_API_TIMEOUT=600

# Exported ComfyUI API workflow (Save (API Format)). The adapter replaces
# {{PROMPT}}, {{NEGATIVE_PROMPT}}, {{WIDTH}}, {{HEIGHT}}, {{FPS}},
# {{DURATION}}, {{SEED}}, and {{MODEL_NAME}} tokens before submitting.
# Leave empty to disable the ComfyUI adapter (it will refuse to run).
COMFYUI_WORKFLOW_PATH=

# Maximum time a single generation job may run, in seconds.
GENERATION_JOB_TIMEOUT_SECONDS=1800

# Path to ffmpeg if not on PATH.
FFMPEG_BIN=ffmpeg

# Film assembly encoding options.
FFMPEG_CONCAT_TRANSCODING=libx264
FILM_TRANSITION_SECONDS=1.0

# =============================================================================
# Background tasks (Celery + Redis)
# =============================================================================

# Broker URL for Celery. Use redis:// for Redis.
CELERY_BROKER_URL=redis://localhost:6379/0

# Result backend. django-db uses django-celery-results.
CELERY_RESULT_BACKEND=django-db

# Run tasks synchronously in process (useful for development without Redis).
CELERY_TASK_ALWAYS_EAGER=True

# Task and worker limits.
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_WORKER_CONCURRENCY=1

# =============================================================================
# Feature flags
# =============================================================================

ENABLE_SYSTEM_MONITOR=True

# CineForge AI — environment configuration
#
# Copy this file to .env and adjust the values for your machine.
# All secrets are kept out of source code.

# =============================================================================
# Django
# =============================================================================

# Change this to a unique, unpredictable value in production.
DJANGO_SECRET_KEY=change-me-in-production

# Keep True only for local development.
DEBUG=True

# Comma-separated list of allowed hosts.
ALLOWED_HOSTS=localhost,127.0.0.1

# Time zone for the application.
TIME_ZONE=UTC

# =============================================================================
# Database (SQLite for local development; PostgreSQL-compatible settings below)
# =============================================================================

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=600

# =============================================================================
# Static and media
# =============================================================================

STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media

# =============================================================================
# File uploads
# =============================================================================

# Maximum upload size in MB.
MAX_UPLOAD_SIZE_MB=50

# Allowed image extensions for reference images.
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp

# =============================================================================
# Inference backend
# =============================================================================

# Default inference adapter: comfyui, wan, ltx, or test.
INFERENCE_DEFAULT_ADAPTER=comfyui

# Base URL of the local ComfyUI instance (if used).
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Timeout in seconds for ComfyUI API calls.
COMFYUI_API_TIMEOUT=600

# Exported ComfyUI API workflow (Save (API Format)). The adapter replaces
# {{PROMPT}}, {{NEGATIVE_PROMPT}}, {{WIDTH}}, {{HEIGHT}}, {{FPS}}, {{FRAMES}},
# {{DURATION}}, {{SEED}}, and {{MODEL_NAME}} tokens before submitting.
# A ready-made Wan 2.2 text-to-video workflow ships at
# comfyui/workflows/wan22_t2v_api.json (needs those model files in ComfyUI).
# Leave empty to disable the ComfyUI adapter (it will refuse to run).
COMFYUI_WORKFLOW_PATH=

# Maximum time a single generation job may run, in seconds.
GENERATION_JOB_TIMEOUT_SECONDS=1800

# Path to ffmpeg if not on PATH. A Windows build ships in tools/bin/
# (FFMPEG_BIN=tools/bin/ffmpeg.exe); relative paths resolve against the
# project root.
FFMPEG_BIN=ffmpeg

# Film assembly encoding options. A lower FILM_VIDEO_CRF means better quality
# (18 is visually near-lossless, 23 is FFmpeg's default and noticeably softer).
FFMPEG_CONCAT_TRANSCODING=libx264
FILM_TRANSITION_SECONDS=1.0
FILM_VIDEO_CRF=18
# Audio bitrate for the scene voiceovers folded into the assembled film.
FILM_AUDIO_BITRATE=192k

# =============================================================================
# Cloud video providers (optional)
# =============================================================================
# CineForge ships six hosted backends alongside the local ComfyUI engine:
# veo, runway, luma, kling, replicate and huggingface. Everything here is
# optional — leave a provider's keys empty and it appears in the engine
# dropdown as "not configured" instead of failing.
#
# Which providers are offered at all (comma separated; blank = all registered):
# VIDEO_PROVIDERS_ENABLED=
# VIDEO_PROVIDERS_DISABLED=luma,replicate
#
# Shared polling/download behaviour:
# VIDEO_PROVIDER_HTTP_TIMEOUT=120      # per request, seconds
# VIDEO_PROVIDER_POLL_SECONDS=3        # status check interval
# VIDEO_PROVIDER_TIMEOUT_SECONDS=1800  # whole job, defaults to GENERATION_JOB_TIMEOUT_SECONDS
# VIDEO_PROVIDER_SYNC_TIMEOUT=600      # single-request providers (Hugging Face)

# Google Veo (the model behind Google Flow) via the Gemini API.
# VEO_MODEL must be a model your account can call; Google retired the Veo 3.1
# preview ids in October 2026, so check ai.google.dev/gemini-api/docs/video.
VEO_API_KEY=
VEO_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VEO_MODEL=

# Runway — director-grade camera control and image-to-video.
RUNWAY_API_KEY=
RUNWAY_API_BASE=https://api.dev.runwayml.com
RUNWAY_API_VERSION=2024-11-06
RUNWAY_MODEL=gen4.5

# Luma Dream Machine (Ray 2) — natural motion, credit based.
# Image-to-video is off: Luma only accepts publicly hosted keyframe URLs.
LUMA_API_KEY=
LUMA_API_BASE=https://api.lumalabs.ai
LUMA_MODEL=ray-2

# Kling AI — value option, 5-10s clips, JWT signed from a key pair.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE=https://api.klingai.com
KLING_MODEL=kling-v1-6

# Replicate — one token, hundreds of open models. REPLICATE_MODEL is required
# and takes an owner/model slug (e.g. wan-video/wan-2.2-t2v-fast).
REPLICATE_API_TOKEN=
REPLICATE_API_BASE=https://api.replicate.com
REPLICATE_MODEL=
# Optional JSON object merged into the prediction input:
REPLICATE_EXTRA_INPUT=

# Hugging Face Inference Providers — open models (Wan, LTX, Hunyuan) at the
# underlying provider's rate. Bearer token must have Inference Providers access.
HF_TOKEN=
HF_API_BASE=https://router.huggingface.co
HF_MODEL=Wan-AI/Wan2.2-TI2V-5B
HF_PROVIDER=hf-inference

# =============================================================================
# Automatic AI voiceover
# =============================================================================
# Wan/LTX generate silent video, so CineForge speaks a cleaned version of the
# prompt with edge-tts (free, no API key) and muxes it with FFmpeg.
VOICEOVER_ENABLED=True
# bn-BD-NabanitaNeural (female), bn-BD-PradeepNeural (male),
# bn-IN-TanishaaNeural (female), bn-IN-BashkarNeural (male).
VOICEOVER_VOICE=bn-BD-NabanitaNeural
# Speech rate and volume offsets, as edge-tts expects them.
VOICEOVER_RATE=+0%
VOICEOVER_VOLUME=+0%
VOICEOVER_AUDIO_BITRATE=192k
# Longest narration line, in characters.
VOICEOVER_MAX_CHARS=240

# =============================================================================
# Background tasks (Celery + Redis)
# =============================================================================

# Broker URL for Celery. Use redis:// for Redis.
CELERY_BROKER_URL=redis://localhost:6379/0

# Result backend. django-db uses django-celery-results.
CELERY_RESULT_BACKEND=django-db

# Run tasks synchronously in process (useful for development without Redis).
CELERY_TASK_ALWAYS_EAGER=True

# Task and worker limits.
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_WORKER_CONCURRENCY=1

# =============================================================================
# Feature flags
# =============================================================================

ENABLE_SYSTEM_MONITOR=True
